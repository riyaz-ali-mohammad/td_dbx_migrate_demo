   "source": [
    "----------------------------------------\n",
    "-- Consumption view on the AML transaction fact.\n",
    "-- Row filter : only segments granted to the session user in VIEW_ACCESS_CTRL\n",
    "-- Column mask: counterparty / customer names, IBAN and card token unless PII_ACCESS_IND = 'Y'\n",
    "----------------------------------------\n",
    "\n",
    "-- Teradata REPLACE VIEW converted to CREATE OR REPLACE VIEW.\n",
    "-- Source database qualifiers removed because no target Unity Catalog mapping was supplied; objects resolve in the current catalog and schema.\n",
    "-- Teradata LOCKING TABLE FOR ACCESS clauses removed; Delta reads a committed snapshot.\n",
    "-- Teradata USER mapped to current_user().\n",
    "-- TODO: manual review required — confirm VARCHAR(140) mask casts preserve the required downstream view-column metadata.\n",
    "-- TODO: manual review required — confirm the explicit RPAD preserves the source CHAR(19) card-token padding expected by consumers.\n",
    "CREATE OR REPLACE VIEW AML_TXN_DAILY\n",
    "AS\n",
    "SELECT\n",
    "       txn.TXN_REF,\n",
    "       txn.SUPPLIER_CD,\n",
    "       txn.BOOKING_DT,\n",
    "       txn.VALUE_DT,\n",
    "       txn.TXN_TMS,\n",
    "       txn.ACCT_ID,\n",
    "       txn.SORT_CD,\n",
    "       txn.ACCT_NR,\n",
    "       txn.PARTY_ID,\n",
    "       txn.PRDT_CD,\n",
    "       txn.SEGMENT_CD,\n",
    "       txn.TXN_TYP_CD,\n",
    "       txn.PAY_SCHEME_CD,\n",
    "       txn.CHNL_CD,\n",
    "       txn.DR_CR_IND,\n",
    "       txn.TXN_AMT,\n",
    "       txn.TXN_CCY_CD,\n",
    "       txn.ORIG_AMT,\n",
    "       txn.ORIG_CCY_CD,\n",
    "       txn.GBP_AMT,\n",
    "       txn.GBP_RATE,\n",
    "       txn.CASH_IND,\n",
    "       txn.XBORDER_IND,\n",
    "       txn.ROUND_AMT_IND,\n",
    "       txn.NARRATIVE_TXT,\n",
    "       txn.CPTY_ID,\n",
    "       CASE WHEN acc.PII_ACCESS_IND = 'Y' THEN txn.CPTY_NM ELSE CAST('*** MASKED ***' AS VARCHAR(140)) END\n",
    "                                                   AS CPTY_NM,\n",
    "       txn.CPTY_SORT_CD,\n",
    "       txn.CPTY_ACCT_NR,\n",
    "       CASE WHEN acc.PII_ACCESS_IND = 'Y' OR txn.CPTY_IBAN IS NULL THEN txn.CPTY_IBAN\n",
    "            ELSE SUBSTR(txn.CPTY_IBAN, 1, 4) || '**************' || SUBSTR(TRIM(txn.CPTY_IBAN), CHARACTER_LENGTH(TRIM(txn.CPTY_IBAN)) - 3, 4) END\n",
    "                                                   AS CPTY_IBAN,\n",
    "       txn.CPTY_BIC_CD,\n",
    "       txn.CPTY_BANK_CTRY_CD,\n",
    "       txn.CPTY_CTRY_CD,\n",
    "       txn.CPTY_CTRY_RISK_CD,\n",
    "       txn.CPTY_INTERNAL_IND,\n",
    "       txn.CPTY_PARTY_ID,\n",
    "       CASE WHEN acc.PII_ACCESS_IND = 'Y' THEN txn.ORDERING_CUST_NM ELSE CAST('*** MASKED ***' AS VARCHAR(140)) END\n",
    "                                                   AS ORDERING_CUST_NM,\n",
    "       CASE WHEN acc.PII_ACCESS_IND = 'Y' THEN txn.BENEF_CUST_NM ELSE CAST('*** MASKED ***' AS VARCHAR(140)) END\n",
    "                                                   AS BENEF_CUST_NM,\n",
    "       txn.PAYMENT_REF,\n",
    "       txn.E2E_ID,\n",
    "       txn.UETR,\n",
    "       txn.SWIFT_MSG_TYP_CD,\n",
    "       txn.INTERMED_BIC_CD,\n",
    "       txn.MCC_CD,\n",
    "       txn.MCC_RISK_CD,\n",
    "       txn.MERCHANT_NM,\n",
    "       txn.MERCHANT_CTRY_CD,\n",
    "       CASE WHEN acc.PII_ACCESS_IND = 'Y' OR txn.CARD_TOKEN IS NULL THEN txn.CARD_TOKEN\n",
    "            ELSE CAST(RPAD('************' || SUBSTR(TRIM(txn.CARD_TOKEN), CHARACTER_LENGTH(TRIM(txn.CARD_TOKEN)) - 3, 4), 19, ' ') AS CHAR(19)) END\n",
    "                                                   AS CARD_TOKEN,\n",
    "       txn.CARD_PRESENT_IND,\n",
    "       txn.ATM_ID,\n",
    "       txn.BRANCH_SORT_CD,\n",
    "       txn.CHEQUE_NR,\n",
    "       txn.DEVICE_ID,\n",
    "       txn.IP_CTRY_CD,\n",
    "       txn.AUTH_METHOD_CD,\n",
    "       txn.COP_RESULT_CD,\n",
    "       txn.APP_FRAUD_IND,\n",
    "       txn.RETURN_REASON_CD,\n",
    "       txn.REVERSAL_IND,\n",
    "       txn.ORIG_TXN_REF,\n",
    "       txn.BAL_AFTER_AMT,\n",
    "       txn.TXN_STATUS_CD,\n",
    "       txn.FEE_AMT,\n",
    "       txn.PURPOSE_CD,\n",
    "       txn.PARTY_RISK_RATING_CD,\n",
    "       txn.PARTY_PEP_IND,\n",
    "       txn.HRC_IND,\n",
    "       txn.SANC_HIT_IND,\n",
    "       txn.DQ_ERR_IND,\n",
    "       txn.BATCH_ID,\n",
    "       txn.FILE_SEQ_NR,\n",
    "       txn.LOAD_TMS,\n",
    "       txn.CO_UPD_TMS\n",
    "FROM\n",
    "       AML_TXN_DAILY txn\n",
    "\n",
    "       INNER JOIN\n",
    "       VIEW_ACCESS_CTRL acc\n",
    "          ON  acc.SEGMENT_CD = txn.SEGMENT_CD\n",
    "          AND acc.USER_NM    = current_user();\n"
   ]
  }
 ],
