CREATE SET TABLE DB_STREAM_DATA.INFO_DLYTXN_ERROR_FXRATE ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      CCY_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      BOOKING_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      TXN_CNT INTEGER,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
UNIQUE PRIMARY INDEX XPKINFO_DLYTXN_ERROR_FXRATE ( CCY_CD ,BOOKING_DT );
