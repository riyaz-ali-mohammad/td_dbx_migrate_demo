CREATE SET TABLE DB_STREAM_DATA.INFO_DLYTXN_ERROR_LOG ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      ERR_AID DECIMAL(12,0) NOT NULL,
      ERR_NR SMALLINT NOT NULL,
      ERR_CLASS VARCHAR(20) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      ERR_KEY VARCHAR(80) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      ERR_FIELD VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC,
      ERR_TABLE VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC,
      ERR_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL,
      ERR_PGM_SOURCE VARCHAR(50) CHARACTER SET LATIN NOT CASESPECIFIC,
      ERR_DESC VARCHAR(200) CHARACTER SET LATIN NOT CASESPECIFIC,
      BUSINESS_DT DATE FORMAT 'YYYY-MM-DD')
UNIQUE PRIMARY INDEX XPKDLYTXN_ERROR_LOG ( ERR_AID );
