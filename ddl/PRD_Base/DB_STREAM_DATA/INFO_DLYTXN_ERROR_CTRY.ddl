CREATE SET TABLE DB_STREAM_DATA.INFO_DLYTXN_ERROR_CTRY ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      CTRY_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      ERR_FIELD VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
UNIQUE PRIMARY INDEX XPKINFO_DLYTXN_ERROR_CTRY ( CTRY_CD ,ERR_FIELD );
