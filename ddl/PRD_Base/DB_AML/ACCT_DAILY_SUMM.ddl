CREATE MULTISET TABLE DB_AML.ACCT_DAILY_SUMM ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      ACCT_ID CHAR(14) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      BUSINESS_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      PARTY_ID CHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC,
      SEGMENT_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      CR_CNT INTEGER,
      CR_GBP_AMT DECIMAL(18,2),
      DR_CNT INTEGER,
      DR_GBP_AMT DECIMAL(18,2),
      CASH_CR_CNT INTEGER,
      CASH_CR_GBP_AMT DECIMAL(18,2),
      CASH_DR_CNT INTEGER,
      CASH_DR_GBP_AMT DECIMAL(18,2),
      XBORDER_CNT INTEGER,
      XBORDER_GBP_AMT DECIMAL(18,2),
      HRC_CNT INTEGER,
      HRC_GBP_AMT DECIMAL(18,2),
      ROUND_AMT_CNT INTEGER,
      NEAR_THRESHOLD_CASH_CNT INTEGER,
      DISTINCT_CPTY_CR_CNT INTEGER,
      DISTINCT_CPTY_DR_CNT INTEGER,
      MAX_TXN_GBP_AMT DECIMAL(18,2),
      GAMBLING_GBP_AMT DECIMAL(18,2),
      CRYPTO_GBP_AMT DECIMAL(18,2),
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
PRIMARY INDEX XNUPI_ACCT_DAILY_SUMM ( ACCT_ID )
PARTITION BY RANGE_N(BUSINESS_DT  BETWEEN DATE '2020-01-01' AND DATE '2030-12-31' EACH INTERVAL '1' DAY ,
 NO RANGE)
UNIQUE INDEX XUSI_ACCT_DAILY_SUMM ( ACCT_ID ,BUSINESS_DT );
