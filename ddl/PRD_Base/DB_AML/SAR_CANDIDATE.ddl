CREATE SET TABLE DB_AML.SAR_CANDIDATE ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      CASE_ID BIGINT NOT NULL,
      PARTY_ID CHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      IDENT_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      SAR_REASON_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC,
      TOTAL_GBP_AMT DECIMAL(18,2),
      SANC_HIT_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      DAML_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC COMPRESS 'N',
      NARRATIVE_SUMMARY VARCHAR(1000) CHARACTER SET LATIN NOT CASESPECIFIC,
      SAR_STATUS_CD CHAR(5) CHARACTER SET LATIN NOT CASESPECIFIC DEFAULT 'DRAFT',
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
UNIQUE PRIMARY INDEX XPKSAR_CANDIDATE ( CASE_ID );
