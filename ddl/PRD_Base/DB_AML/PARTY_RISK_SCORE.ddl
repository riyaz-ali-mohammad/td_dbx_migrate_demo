CREATE SET TABLE DB_AML.PARTY_RISK_SCORE ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      PARTY_ID CHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      SCORE_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      CTRY_SCORE SMALLINT,
      PEP_SCORE SMALLINT,
      OCCP_SCORE SMALLINT,
      PRDT_SCORE SMALLINT,
      CHNL_SCORE SMALLINT,
      ALERT_SCORE SMALLINT,
      SANC_SCORE SMALLINT,
      KYC_SCORE SMALLINT,
      ADV_MEDIA_SCORE SMALLINT,
      TOTAL_SCORE SMALLINT,
      RISK_BAND_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      PREV_RISK_BAND_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      BAND_CHG_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC COMPRESS 'N',
      EDD_REQUIRED_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC COMPRESS 'N',
      NEXT_REVIEW_DT DATE FORMAT 'YYYY-MM-DD',
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
UNIQUE PRIMARY INDEX XPKPARTY_RISK_SCORE ( PARTY_ID );
