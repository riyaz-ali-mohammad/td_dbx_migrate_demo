CREATE SET TABLE DB_AML.EDD_REVIEW_QUEUE ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      PARTY_ID CHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      TRIGGER_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      TRIGGER_REASON_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      RISK_BAND_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      PREV_RISK_BAND_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      DUE_DT DATE FORMAT 'YYYY-MM-DD',
      REVIEW_STATUS_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC DEFAULT 'OPEN',
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
UNIQUE PRIMARY INDEX XPKEDD_REVIEW_QUEUE ( PARTY_ID ,TRIGGER_DT ,TRIGGER_REASON_CD );
