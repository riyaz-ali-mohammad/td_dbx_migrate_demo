CREATE MULTISET TABLE DB_AML.SANC_SCREEN_HIT ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      HIT_ID BIGINT GENERATED ALWAYS AS IDENTITY
           (START WITH 1
            INCREMENT BY 1
            MINVALUE 1
            MAXVALUE 999999999999999999
            NO CYCLE),
      TXN_REF VARCHAR(35) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      SUPPLIER_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      BUSINESS_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      ACCT_ID CHAR(14) CHARACTER SET LATIN NOT CASESPECIFIC,
      PARTY_ID CHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC,
      NM_ROLE_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      SCREENED_NM VARCHAR(140) CHARACTER SET LATIN NOT CASESPECIFIC,
      GROUP_ID INTEGER NOT NULL,
      MATCHED_NM VARCHAR(400) CHARACTER SET LATIN NOT CASESPECIFIC,
      REGIME_NM VARCHAR(100) CHARACTER SET LATIN NOT CASESPECIFIC,
      MATCH_TYP_CD CHAR(5) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      MATCH_SCORE DECIMAL(5,2),
      HIT_STATUS_CD CHAR(5) CHARACTER SET LATIN NOT CASESPECIFIC DEFAULT 'OPEN',
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
PRIMARY INDEX XNUPI_SANC_SCREEN_HIT ( TXN_REF ,SUPPLIER_CD );
