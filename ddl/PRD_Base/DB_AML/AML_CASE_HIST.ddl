CREATE SET TABLE DB_AML.AML_CASE_HIST ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      CASE_ID BIGINT NOT NULL,
      UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL,
      PARTY_ID CHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      CASE_OPEN_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      CASE_STATUS_CD CHAR(5) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      CASE_PRIORITY_NR BYTEINT,
      QUEUE_CD CHAR(6) CHARACTER SET LATIN NOT CASESPECIFIC,
      SLA_DUE_DT DATE FORMAT 'YYYY-MM-DD',
      ALERT_CNT INTEGER,
      TOTAL_ALERT_SCORE INTEGER,
      TOTAL_HIT_GBP_AMT DECIMAL(18,2),
      RULE_LIST VARCHAR(200) CHARACTER SET LATIN NOT CASESPECIFIC,
      SAR_CANDIDATE_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC COMPRESS 'N',
      RISK_BAND_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      SEGMENT_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      FIRST_ALERT_DT DATE FORMAT 'YYYY-MM-DD',
      LAST_ALERT_DT DATE FORMAT 'YYYY-MM-DD',
      CASE_CLOSE_DT DATE FORMAT 'YYYY-MM-DD',
      CLOSE_REASON_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC,
      HIST_ACTION_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS')
UNIQUE PRIMARY INDEX XPKAML_CASE_HIST ( CASE_ID ,UPD_TMS );
