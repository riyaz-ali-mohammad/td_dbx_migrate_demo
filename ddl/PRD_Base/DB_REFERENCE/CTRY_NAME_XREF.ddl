CREATE SET TABLE DB_REFERENCE.CTRY_NAME_XREF ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      CTRY_NM_TXT VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      CTRY_2_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL)
UNIQUE PRIMARY INDEX XPKCTRY_NAME_XREF ( CTRY_NM_TXT );
