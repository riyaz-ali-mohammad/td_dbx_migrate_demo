CREATE SET TABLE DB_REFERENCE.UK_BANK_HOLIDAY ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      HOLIDAY_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      HOLIDAY_NM VARCHAR(50) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKUK_BANK_HOLIDAY ( HOLIDAY_DT );
