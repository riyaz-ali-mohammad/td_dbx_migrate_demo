CREATE SET TABLE DB_REFERENCE.RETURN_REASON ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      RETURN_REASON_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      RETURN_REASON_DESC VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC,
      AUTO_ADDED_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC DEFAULT 'N',
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS')
UNIQUE PRIMARY INDEX XPKRETURN_REASON ( RETURN_REASON_CD );
