CREATE SET TABLE DB_REFERENCE.SANC_REGIME_CTRY ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      REGIME_NM VARCHAR(100) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      CTRY_2_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      COMPREHENSIVE_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKSANC_REGIME_CTRY ( REGIME_NM ,CTRY_2_CD );
