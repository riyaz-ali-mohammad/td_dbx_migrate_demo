CREATE SET TABLE DB_AML_MI.CUST_RISK_DIST_DAILY ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      BUSINESS_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      SEGMENT_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      RISK_BAND_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      PARTY_CNT INTEGER,
      PEP_CNT INTEGER,
      EDD_CNT INTEGER,
      BAND_UP_CNT INTEGER,
      BAND_DOWN_CNT INTEGER,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS')
UNIQUE PRIMARY INDEX XPKCUST_RISK_DIST_DAILY ( BUSINESS_DT ,SEGMENT_CD ,RISK_BAND_CD );
