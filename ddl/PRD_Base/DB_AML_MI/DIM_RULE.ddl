CREATE SET TABLE DB_AML_MI.DIM_RULE ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      RULE_CD CHAR(8) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      RULE_DESC VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC,
      RULE_FAMILY_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC,
      ACTIVE_SEGMENT_CNT SMALLINT,
      MIN_AMT_THRESHOLD DECIMAL(18,2),
      MAX_SCORE_WEIGHT SMALLINT,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS')
UNIQUE PRIMARY INDEX XPKDIM_RULE ( RULE_CD );
