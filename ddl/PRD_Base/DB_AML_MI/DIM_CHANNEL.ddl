CREATE SET TABLE DB_AML_MI.DIM_CHANNEL ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      CHNL_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      CHNL_DESC VARCHAR(40) CHARACTER SET LATIN NOT CASESPECIFIC,
      DIGITAL_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS')
UNIQUE PRIMARY INDEX XPKDIM_CHANNEL ( CHNL_CD );
