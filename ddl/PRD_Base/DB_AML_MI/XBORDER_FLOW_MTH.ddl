CREATE SET TABLE DB_AML_MI.XBORDER_FLOW_MTH ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      YR_MON INTEGER NOT NULL,
      CTRY_2_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      DR_CR_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      FATF_STATUS_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      CTRY_RISK_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      TXN_CNT INTEGER,
      GBP_AMT DECIMAL(18,2),
      PARTY_CNT INTEGER,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS')
UNIQUE PRIMARY INDEX XPKXBORDER_FLOW_MTH ( YR_MON ,CTRY_2_CD ,DR_CR_IND );
