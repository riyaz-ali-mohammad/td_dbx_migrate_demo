CREATE SET TABLE DB_AML_MI.DIM_RISK_BAND ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      RISK_BAND_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      RISK_BAND_DESC VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC,
      MIN_SCORE SMALLINT,
      MAX_SCORE SMALLINT,
      REVIEW_FREQ_MTHS SMALLINT,
      SORT_ORDER_NR BYTEINT,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS')
UNIQUE PRIMARY INDEX XPKDIM_RISK_BAND ( RISK_BAND_CD );
