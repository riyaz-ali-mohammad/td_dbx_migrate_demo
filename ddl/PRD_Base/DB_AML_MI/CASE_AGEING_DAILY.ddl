CREATE SET TABLE DB_AML_MI.CASE_AGEING_DAILY ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      BUSINESS_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      QUEUE_CD CHAR(6) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      CASE_STATUS_CD CHAR(5) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      AGE_BAND_CD CHAR(5) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      CASE_CNT INTEGER,
      OVER_SLA_CNT INTEGER,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS')
UNIQUE PRIMARY INDEX XPKCASE_AGEING_DAILY ( BUSINESS_DT ,QUEUE_CD ,CASE_STATUS_CD ,AGE_BAND_CD );
