CREATE SET TABLE DB_AML_MI.RULE_EFFECTIVENESS_MTH ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      YR_MON INTEGER NOT NULL,
      RULE_CD CHAR(8) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      ALERT_CNT INTEGER,
      CASED_CNT INTEGER,
      SAR_CNT INTEGER,
      CLOSED_NFA_CNT INTEGER,
      CONVERSION_PCT DECIMAL(7,2),
      FALSE_POS_PCT DECIMAL(7,2),
      RANK_IN_MTH SMALLINT,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS')
UNIQUE PRIMARY INDEX XPKRULE_EFFECTIVENESS_MTH ( YR_MON ,RULE_CD );
