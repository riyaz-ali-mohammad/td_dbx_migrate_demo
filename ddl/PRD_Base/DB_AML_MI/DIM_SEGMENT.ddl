CREATE SET TABLE DB_AML_MI.DIM_SEGMENT ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      SEGMENT_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      SEGMENT_DESC VARCHAR(40) CHARACTER SET LATIN NOT CASESPECIFIC,
      PARTY_CNT INTEGER,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS')
UNIQUE PRIMARY INDEX XPKDIM_SEGMENT ( SEGMENT_CD );
