CREATE SET TABLE DB_ODS.SANC_ENTITY ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      GROUP_ID INTEGER NOT NULL,
      GROUP_TYP_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      REGIME_NM VARCHAR(100) CHARACTER SET LATIN NOT CASESPECIFIC,
      LISTED_DT DATE FORMAT 'YYYY-MM-DD',
      LAST_UPD_DT DATE FORMAT 'YYYY-MM-DD',
      UK_SANC_REF VARCHAR(20) CHARACTER SET LATIN NOT CASESPECIFIC,
      BIRTH_DT DATE FORMAT 'YYYY-MM-DD',
      NATIONALITY_CTRY_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      ADDR_CTRY_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      PASSPORT_NR VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC,
      ACTIVE_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC DEFAULT 'Y',
      DELISTED_DT DATE FORMAT 'YYYY-MM-DD',
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
UNIQUE PRIMARY INDEX XPKSANC_ENTITY ( GROUP_ID );
