CREATE SET TABLE DB_ODS.SANC_BIC ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      BIC_CD CHAR(11) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      GROUP_ID INTEGER NOT NULL,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS')
UNIQUE PRIMARY INDEX XPKSANC_BIC ( BIC_CD ,GROUP_ID );
