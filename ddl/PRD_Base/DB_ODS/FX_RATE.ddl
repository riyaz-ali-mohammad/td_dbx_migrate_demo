CREATE SET TABLE DB_ODS.FX_RATE ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      CCY_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      RATE_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      RATE_TYP_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      GBP_RATE DECIMAL(18,8) NOT NULL,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
UNIQUE PRIMARY INDEX XPKFX_RATE ( CCY_CD ,RATE_DT ,RATE_TYP_CD );
