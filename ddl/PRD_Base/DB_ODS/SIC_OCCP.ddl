CREATE SET TABLE DB_ODS.SIC_OCCP ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      SIC_CD CHAR(5) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      START_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      END_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL DEFAULT DATE '9999-12-31',
      SIC_DESC VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC,
      SIC_RISK_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      CASH_INTENSIVE_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
UNIQUE PRIMARY INDEX XPKSIC_OCCP ( SIC_CD ,START_DT );
