CREATE SET TABLE DB_ODS.CCY_SNAPSHOT ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      CCY_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      MINOR_UNIT_CNT BYTEINT)
UNIQUE PRIMARY INDEX XPKCCY_SNAPSHOT ( CCY_CD );
