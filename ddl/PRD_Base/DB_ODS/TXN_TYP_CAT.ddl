CREATE SET TABLE DB_ODS.TXN_TYP_CAT ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      CD_DESC VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC DEFAULT 'UNKNOWN - AUTO ADDED',
      AUTO_ADDED_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC DEFAULT 'N',
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
UNIQUE PRIMARY INDEX XPKTXN_TYP_CAT ( CD );
