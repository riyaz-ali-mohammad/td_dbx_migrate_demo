CREATE SET TABLE DB_ODS.SORT_CD_DIR ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      SORT_CD CHAR(6) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      START_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      END_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL DEFAULT DATE '9999-12-31',
      BANK_NM VARCHAR(40) CHARACTER SET LATIN NOT CASESPECIFIC,
      BRANCH_NM VARCHAR(40) CHARACTER SET LATIN NOT CASESPECIFIC,
      BIC_CD CHAR(11) CHARACTER SET LATIN NOT CASESPECIFIC,
      FPS_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      CHAPS_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      BACS_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      CLOSED_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      POSTCODE VARCHAR(8) CHARACTER SET LATIN NOT CASESPECIFIC,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
UNIQUE PRIMARY INDEX XPKSORT_CD_DIR ( SORT_CD ,START_DT );
