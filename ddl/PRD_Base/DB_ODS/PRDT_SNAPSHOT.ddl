CREATE SET TABLE DB_ODS.PRDT_SNAPSHOT ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      PRDT_CD CHAR(6) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      PRDT_FAMILY_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC,
      SEGMENT_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      PRDT_RISK_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKPRDT_SNAPSHOT ( PRDT_CD );
