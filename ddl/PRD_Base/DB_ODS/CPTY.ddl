CREATE SET TABLE DB_ODS.CPTY ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      CPTY_ID BIGINT NOT NULL,
      CPTY_ACCT_KEY VARCHAR(34) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      CPTY_NORM_NM VARCHAR(140) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      CPTY_BIC_CD CHAR(11) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_CTRY_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      FIRST_SEEN_DT DATE FORMAT 'YYYY-MM-DD',
      LAST_SEEN_DT DATE FORMAT 'YYYY-MM-DD',
      TXN_CNT INTEGER,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
UNIQUE PRIMARY INDEX XPKCPTY ( CPTY_ID )
UNIQUE INDEX XUSI_CPTY_KEY ( CPTY_ACCT_KEY ,CPTY_NORM_NM );
