CREATE MULTISET TABLE DB_ODS.SANC_NAME_TOKEN ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      TOKEN_TXT VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      GROUP_ID INTEGER NOT NULL,
      NAME_SEQ_NR SMALLINT NOT NULL,
      TOKEN_SEQ_NR SMALLINT NOT NULL,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS')
PRIMARY INDEX XNUPI_SANC_NAME_TOKEN ( TOKEN_TXT );
