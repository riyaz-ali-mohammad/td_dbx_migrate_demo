CREATE SET TABLE DB_ODS.PARTY_ALIAS ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      PARTY_ID CHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      ALIAS_SEQ_NR SMALLINT NOT NULL,
      ALIAS_NM VARCHAR(100) CHARACTER SET LATIN NOT CASESPECIFIC,
      ALIAS_NORM_NM VARCHAR(100) CHARACTER SET LATIN NOT CASESPECIFIC,
      ALIAS_TYP_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
UNIQUE PRIMARY INDEX XPKPARTY_ALIAS ( PARTY_ID ,ALIAS_SEQ_NR );
