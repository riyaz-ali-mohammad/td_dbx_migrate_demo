CREATE SET TABLE DB_ODS.CHNL ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      CHNL_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      START_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      END_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL DEFAULT DATE '9999-12-31',
      CHNL_DESC VARCHAR(40) CHARACTER SET LATIN NOT CASESPECIFIC,
      DIGITAL_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
UNIQUE PRIMARY INDEX XPKCHNL ( CHNL_CD ,START_DT );
