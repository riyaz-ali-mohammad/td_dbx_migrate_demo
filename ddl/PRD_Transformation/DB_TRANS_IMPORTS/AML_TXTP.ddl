CREATE SET TABLE DB_TRANS_IMPORTS.AML_TXTP ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      TXN_TYP_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      TXN_TYP_DESC VARCHAR(50) CHARACTER SET LATIN NOT CASESPECIFIC,
      PAY_SCHEME_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC,
      DIRECTION_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      CASH_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      XBORDER_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      ACTION_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKAML_TXTP ( TXN_TYP_CD );
