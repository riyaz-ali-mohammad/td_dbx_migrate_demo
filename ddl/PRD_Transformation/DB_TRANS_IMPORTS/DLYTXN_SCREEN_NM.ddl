CREATE SET TABLE DB_TRANS_IMPORTS.DLYTXN_SCREEN_NM ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      TXN_REF VARCHAR(35) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      SUPPLIER_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      NM_ROLE_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      RAW_NM VARCHAR(140) CHARACTER SET LATIN NOT CASESPECIFIC,
      NORM_NM VARCHAR(140) CHARACTER SET LATIN NOT CASESPECIFIC,
      CTRY_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      BIC_CD CHAR(11) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKDLYTXN_SCREEN_NM ( TXN_REF ,SUPPLIER_CD ,NM_ROLE_CD );
