CREATE SET TABLE DB_TRANS_IMPORTS.AML_FXRT ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      CCY_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      RATE_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      RATE_TYP_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      GBP_RATE DECIMAL(18,8),
      ACTION_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKAML_FXRT ( CCY_CD ,RATE_DT ,RATE_TYP_CD );
