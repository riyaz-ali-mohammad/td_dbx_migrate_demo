CREATE SET TABLE DB_TRANS_IMPORTS.SANC_TOKEN_STG ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      GROUP_ID INTEGER NOT NULL,
      NAME_SEQ_NR SMALLINT NOT NULL,
      TOKEN_SEQ_NR SMALLINT NOT NULL,
      TOKEN_TXT VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKSANC_TOKEN_STG ( GROUP_ID ,NAME_SEQ_NR ,TOKEN_SEQ_NR );
