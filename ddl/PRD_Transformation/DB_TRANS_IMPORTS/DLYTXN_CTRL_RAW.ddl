CREATE MULTISET TABLE DB_TRANS_IMPORTS.DLYTXN_CTRL_RAW ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      RECTYPE CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      SUPPLIER_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC,
      FILE_ID CHAR(20) CHARACTER SET LATIN NOT CASESPECIFIC,
      EXTRACT_DT CHAR(8) CHARACTER SET LATIN NOT CASESPECIFIC,
      REC_CNT CHAR(10) CHARACTER SET LATIN NOT CASESPECIFIC,
      DR_TOTAL CHAR(18) CHARACTER SET LATIN NOT CASESPECIFIC,
      CR_TOTAL CHAR(18) CHARACTER SET LATIN NOT CASESPECIFIC,
      CREATED_TMS CHAR(14) CHARACTER SET LATIN NOT CASESPECIFIC)
PRIMARY INDEX XNUPI_DLYTXN_CTRL_RAW ( FILE_ID );
