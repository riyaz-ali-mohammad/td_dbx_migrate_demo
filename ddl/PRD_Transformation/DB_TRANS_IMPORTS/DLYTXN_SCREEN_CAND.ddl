CREATE MULTISET TABLE DB_TRANS_IMPORTS.DLYTXN_SCREEN_CAND ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      TXN_REF VARCHAR(35) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      SUPPLIER_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      NM_ROLE_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      GROUP_ID INTEGER NOT NULL,
      NAME_SEQ_NR SMALLINT NOT NULL,
      MATCH_TOKEN_CNT SMALLINT,
      SANC_TOKEN_CNT SMALLINT,
      SCREEN_TOKEN_CNT SMALLINT,
      MATCH_TYP_CD CHAR(5) CHARACTER SET LATIN NOT CASESPECIFIC,
      MATCH_SCORE DECIMAL(5,2))
PRIMARY INDEX XNUPI_DLYTXN_SCREEN_CAND ( TXN_REF ,SUPPLIER_CD );
