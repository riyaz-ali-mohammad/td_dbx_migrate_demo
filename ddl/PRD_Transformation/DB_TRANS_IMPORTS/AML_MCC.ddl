CREATE SET TABLE DB_TRANS_IMPORTS.AML_MCC ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      MCC_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      MCC_DESC VARCHAR(50) CHARACTER SET LATIN NOT CASESPECIFIC,
      MCC_RISK_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      CASH_LIKE_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      GAMBLING_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      CRYPTO_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      ACTION_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKAML_MCC ( MCC_CD );
