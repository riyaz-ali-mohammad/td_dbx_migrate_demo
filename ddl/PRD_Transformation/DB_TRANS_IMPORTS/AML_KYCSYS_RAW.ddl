CREATE MULTISET TABLE DB_TRANS_IMPORTS.AML_KYCSYS_RAW ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      A CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      B CHAR(26) CHARACTER SET LATIN NOT CASESPECIFIC,
      C CHAR(472) CHARACTER SET LATIN NOT CASESPECIFIC)
PRIMARY INDEX XNUPI_AML_KYCSYS_RAW ( A ,B );
