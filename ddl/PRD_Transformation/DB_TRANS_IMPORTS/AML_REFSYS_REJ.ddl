CREATE MULTISET TABLE DB_TRANS_IMPORTS.AML_REFSYS_REJ ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      A CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      B CHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC,
      C CHAR(221) CHARACTER SET LATIN NOT CASESPECIFIC,
      REJ_REASON VARCHAR(50) CHARACTER SET LATIN NOT CASESPECIFIC,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS')
PRIMARY INDEX XNUPI_AML_REFSYS_REJ ( A ,B );
