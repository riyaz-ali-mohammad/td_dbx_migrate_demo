CREATE MULTISET TABLE DB_TRANS_IMPORTS.AML_SANCSYS_RAW ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      GROUP_ID VARCHAR(10) CHARACTER SET LATIN NOT CASESPECIFIC,
      NAME_6 VARCHAR(100) CHARACTER SET LATIN NOT CASESPECIFIC,
      NAME_1 VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC,
      NAME_2 VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC,
      NAME_3 VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC,
      NAME_4 VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC,
      NAME_5 VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC,
      TITLE VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC,
      NAME_NON_LATIN VARCHAR(200) CHARACTER SET UNICODE NOT CASESPECIFIC,
      DOB VARCHAR(10) CHARACTER SET LATIN NOT CASESPECIFIC,
      TOWN_OF_BIRTH VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC,
      CTRY_OF_BIRTH VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC,
      NATIONALITY VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC,
      PASSPORT_NR VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC,
      NATIONAL_ID_NR VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC,
      POSITION VARCHAR(200) CHARACTER SET LATIN NOT CASESPECIFIC,
      ADDR_1 VARCHAR(100) CHARACTER SET LATIN NOT CASESPECIFIC,
      ADDR_CTRY VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC,
      OTHER_INFO VARCHAR(500) CHARACTER SET LATIN NOT CASESPECIFIC,
      GROUP_TYPE VARCHAR(20) CHARACTER SET LATIN NOT CASESPECIFIC,
      ALIAS_TYPE VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC,
      ALIAS_QUALITY VARCHAR(10) CHARACTER SET LATIN NOT CASESPECIFIC,
      REGIME VARCHAR(100) CHARACTER SET LATIN NOT CASESPECIFIC,
      LISTED_ON VARCHAR(10) CHARACTER SET LATIN NOT CASESPECIFIC,
      UK_SANC_LIST_DT VARCHAR(10) CHARACTER SET LATIN NOT CASESPECIFIC,
      LAST_UPDATED VARCHAR(10) CHARACTER SET LATIN NOT CASESPECIFIC,
      UK_SANC_LIST_REF VARCHAR(20) CHARACTER SET LATIN NOT CASESPECIFIC)
PRIMARY INDEX XNUPI_AML_SANCSYS_RAW ( GROUP_ID );
