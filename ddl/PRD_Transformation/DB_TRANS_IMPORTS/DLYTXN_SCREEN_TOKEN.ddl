CREATE MULTISET TABLE DB_TRANS_IMPORTS.DLYTXN_SCREEN_TOKEN ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      TXN_REF VARCHAR(35) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      SUPPLIER_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      NM_ROLE_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      TOKEN_SEQ_NR SMALLINT NOT NULL,
      TOKEN_TXT VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC)
PRIMARY INDEX XNUPI_DLYTXN_SCREEN_TOKEN ( TXN_REF ,SUPPLIER_CD );
