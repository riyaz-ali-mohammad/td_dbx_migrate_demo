CREATE MULTISET TABLE DB_TRANS_IMPORTS.AML_RULE_HIT_WRK ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      RULE_CD CHAR(8) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      PARTY_ID CHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC,
      ACCT_ID CHAR(14) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      BUSINESS_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      HIT_GBP_AMT DECIMAL(18,2),
      HIT_CNT INTEGER,
      LOOKBACK_START_DT DATE FORMAT 'YYYY-MM-DD',
      LOOKBACK_END_DT DATE FORMAT 'YYYY-MM-DD',
      ALERT_SCORE SMALLINT,
      TRIGGER_TXN_REF VARCHAR(35) CHARACTER SET LATIN NOT CASESPECIFIC,
      TRIGGER_SUPPLIER_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC,
      HIT_DETAIL VARCHAR(500) CHARACTER SET LATIN NOT CASESPECIFIC)
PRIMARY INDEX XNUPI_AML_RULE_HIT_WRK ( ACCT_ID );
