CREATE SET TABLE DB_TRANS_IMPORTS.DLYTXN_FINAL ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      TXN_REF VARCHAR(35) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      SUPPLIER_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      BOOKING_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      VALUE_DT DATE FORMAT 'YYYY-MM-DD',
      TXN_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS',
      ACCT_ID CHAR(14) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      SORT_CD CHAR(6) CHARACTER SET LATIN NOT CASESPECIFIC,
      ACCT_NR CHAR(8) CHARACTER SET LATIN NOT CASESPECIFIC,
      PARTY_ID CHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC,
      PRDT_CD CHAR(6) CHARACTER SET LATIN NOT CASESPECIFIC,
      SEGMENT_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      TXN_TYP_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC,
      PAY_SCHEME_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC,
      CHNL_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      DR_CR_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      TXN_AMT DECIMAL(18,2),
      TXN_CCY_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      ORIG_AMT DECIMAL(18,2),
      ORIG_CCY_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      GBP_AMT DECIMAL(18,2),
      GBP_RATE DECIMAL(18,8),
      CASH_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC COMPRESS 'N',
      XBORDER_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC COMPRESS 'N',
      ROUND_AMT_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC COMPRESS 'N',
      NARRATIVE_TXT VARCHAR(140) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_ID BIGINT,
      CPTY_NM VARCHAR(140) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_SORT_CD CHAR(6) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_ACCT_NR CHAR(8) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_IBAN VARCHAR(34) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_BIC_CD CHAR(11) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_BANK_CTRY_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_CTRY_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_CTRY_RISK_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_INTERNAL_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_PARTY_ID CHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC,
      ORDERING_CUST_NM VARCHAR(140) CHARACTER SET LATIN NOT CASESPECIFIC,
      BENEF_CUST_NM VARCHAR(140) CHARACTER SET LATIN NOT CASESPECIFIC,
      PAYMENT_REF VARCHAR(35) CHARACTER SET LATIN NOT CASESPECIFIC,
      E2E_ID VARCHAR(35) CHARACTER SET LATIN NOT CASESPECIFIC,
      UETR CHAR(36) CHARACTER SET LATIN NOT CASESPECIFIC,
      SWIFT_MSG_TYP_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      INTERMED_BIC_CD CHAR(11) CHARACTER SET LATIN NOT CASESPECIFIC,
      MCC_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC,
      MCC_RISK_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      MERCHANT_NM VARCHAR(40) CHARACTER SET LATIN NOT CASESPECIFIC,
      MERCHANT_CTRY_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      CARD_TOKEN CHAR(19) CHARACTER SET LATIN NOT CASESPECIFIC,
      CARD_PRESENT_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      ATM_ID CHAR(8) CHARACTER SET LATIN NOT CASESPECIFIC,
      BRANCH_SORT_CD CHAR(6) CHARACTER SET LATIN NOT CASESPECIFIC,
      CHEQUE_NR CHAR(6) CHARACTER SET LATIN NOT CASESPECIFIC,
      DEVICE_ID VARCHAR(40) CHARACTER SET LATIN NOT CASESPECIFIC,
      IP_CTRY_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      AUTH_METHOD_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      COP_RESULT_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      APP_FRAUD_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC COMPRESS 'N',
      RETURN_REASON_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC,
      REVERSAL_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC COMPRESS 'N',
      ORIG_TXN_REF VARCHAR(35) CHARACTER SET LATIN NOT CASESPECIFIC,
      BAL_AFTER_AMT DECIMAL(18,2),
      TXN_STATUS_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      FEE_AMT DECIMAL(18,2),
      PURPOSE_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC,
      PARTY_RISK_RATING_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      PARTY_PEP_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC COMPRESS 'N',
      HRC_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC COMPRESS 'N',
      SANC_HIT_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC COMPRESS 'N',
      DQ_ERR_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC COMPRESS 'N',
      BATCH_ID VARCHAR(20) CHARACTER SET LATIN NOT CASESPECIFIC,
      FILE_SEQ_NR INTEGER,
      LOAD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS',
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS')
UNIQUE PRIMARY INDEX XPKDLYTXN_FINAL ( TXN_REF ,SUPPLIER_CD );
