CREATE SET TABLE DB_TRANS_IMPORTS.KYC_PTAC_STG ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      PARTY_ID CHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      ACCT_ID CHAR(14) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      ROLE_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      START_DT DATE FORMAT 'YYYY-MM-DD',
      END_DT DATE FORMAT 'YYYY-MM-DD',
      OWNERSHIP_PCT DECIMAL(5,2),
      ACTION_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKKYC_PTAC_STG ( PARTY_ID ,ACCT_ID ,ROLE_CD );
