CREATE SET TABLE DB_TRANS_IMPORTS.DLYTXN_LOAD ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      SUPPLIER_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      FILE_SEQ_NR INTEGER,
      TXN_REF VARCHAR(35) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      TXN_SEQ_NR SMALLINT,
      ACCT_ID CHAR(14) CHARACTER SET LATIN NOT CASESPECIFIC,
      SORT_CD CHAR(6) CHARACTER SET LATIN NOT CASESPECIFIC,
      ACCT_NR CHAR(8) CHARACTER SET LATIN NOT CASESPECIFIC,
      TXN_TYP_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC,
      CHNL_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      DR_CR_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      TXN_AMT DECIMAL(18,2),
      TXN_CCY CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      ORIG_AMT DECIMAL(18,2),
      ORIG_CCY CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      BOOKING_DT DATE FORMAT 'YYYY-MM-DD',
      VALUE_DT DATE FORMAT 'YYYY-MM-DD',
      TXN_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS',
      NARRATIVE VARCHAR(140) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_NM VARCHAR(140) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_SORT_CD CHAR(6) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_ACCT_NR CHAR(8) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_IBAN VARCHAR(34) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_BIC CHAR(11) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_BANK_CTRY CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_CTRY CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      ORDERING_CUST_NM VARCHAR(140) CHARACTER SET LATIN NOT CASESPECIFIC,
      BENEF_CUST_NM VARCHAR(140) CHARACTER SET LATIN NOT CASESPECIFIC,
      PAYMENT_REF VARCHAR(35) CHARACTER SET LATIN NOT CASESPECIFIC,
      E2E_ID VARCHAR(35) CHARACTER SET LATIN NOT CASESPECIFIC,
      UETR CHAR(36) CHARACTER SET LATIN NOT CASESPECIFIC,
      SWIFT_MSG_TYP CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      CHARGE_BEARER CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      INTERMED_BIC CHAR(11) CHARACTER SET LATIN NOT CASESPECIFIC,
      MCC CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC,
      MERCHANT_NM VARCHAR(40) CHARACTER SET LATIN NOT CASESPECIFIC,
      MERCHANT_CTRY CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      MERCHANT_ID VARCHAR(15) CHARACTER SET LATIN NOT CASESPECIFIC,
      TERMINAL_ID CHAR(8) CHARACTER SET LATIN NOT CASESPECIFIC,
      ATM_ID CHAR(8) CHARACTER SET LATIN NOT CASESPECIFIC,
      CARD_TOKEN CHAR(19) CHARACTER SET LATIN NOT CASESPECIFIC,
      POS_ENTRY_MODE CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      CARD_PRESENT_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      BRANCH_SORT_CD CHAR(6) CHARACTER SET LATIN NOT CASESPECIFIC,
      TELLER_ID CHAR(8) CHARACTER SET LATIN NOT CASESPECIFIC,
      CASH_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      CHEQUE_NR CHAR(6) CHARACTER SET LATIN NOT CASESPECIFIC,
      DEVICE_ID VARCHAR(40) CHARACTER SET LATIN NOT CASESPECIFIC,
      IP_ADDR VARCHAR(45) CHARACTER SET LATIN NOT CASESPECIFIC,
      IP_CTRY CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      SESSION_ID VARCHAR(36) CHARACTER SET LATIN NOT CASESPECIFIC,
      AUTH_METHOD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      COP_RESULT CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      APP_FRAUD_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      RETURN_REASON_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC,
      REVERSAL_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      ORIG_TXN_REF VARCHAR(35) CHARACTER SET LATIN NOT CASESPECIFIC,
      BAL_AFTER DECIMAL(18,2),
      TXN_STATUS CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      FEE_AMT DECIMAL(18,2),
      PURPOSE_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC,
      BATCH_ID VARCHAR(20) CHARACTER SET LATIN NOT CASESPECIFIC,
      EXTRACT_DT DATE FORMAT 'YYYY-MM-DD',
      LOAD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS')
UNIQUE PRIMARY INDEX XPKDLYTXN_LOAD ( TXN_REF ,SUPPLIER_CD );
