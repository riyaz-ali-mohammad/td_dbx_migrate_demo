CREATE MULTISET TABLE DB_TRANS_IMPORTS.AML_RULE_TXN_WRK ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      RULE_CD CHAR(8) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      ACCT_ID CHAR(14) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      BUSINESS_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      TXN_REF VARCHAR(35) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      SUPPLIER_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL)
PRIMARY INDEX XNUPI_AML_RULE_TXN_WRK ( ACCT_ID );
