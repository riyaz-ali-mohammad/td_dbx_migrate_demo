CREATE SET TABLE DB_TRANS_IMPORTS.KYC_PARTY_STG ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      PARTY_ID CHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      PARTY_TYP_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      FULL_NM VARCHAR(100) CHARACTER SET LATIN NOT CASESPECIFIC,
      BIRTH_DT DATE FORMAT 'YYYY-MM-DD',
      NATIONALITY_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      RESIDENCE_CTRY_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      SIC_CD CHAR(5) CHARACTER SET LATIN NOT CASESPECIFIC,
      PEP_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      PEP_TYP_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      ADV_MEDIA_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      SEGMENT_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      ONBOARD_DT DATE FORMAT 'YYYY-MM-DD',
      KYC_REVIEW_DUE_DT DATE FORMAT 'YYYY-MM-DD',
      KYC_STATUS_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      CDD_LEVEL_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      RISK_RATING_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      RM_ID CHAR(8) CHARACTER SET LATIN NOT CASESPECIFIC,
      POSTCODE VARCHAR(8) CHARACTER SET LATIN NOT CASESPECIFIC,
      CO_HOUSE_NR CHAR(8) CHARACTER SET LATIN NOT CASESPECIFIC,
      INCORP_CTRY_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      EXP_MTH_TURNOVER_AMT DECIMAL(18,2),
      SRC_OF_FUNDS_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      CLOSED_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      ACTION_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKKYC_PARTY_STG ( PARTY_ID );
