CREATE SET TABLE DB_TRANS_IMPORTS.KYC_ACCT_STG ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      ACCT_ID CHAR(14) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      SORT_CD CHAR(6) CHARACTER SET LATIN NOT CASESPECIFIC,
      ACCT_NR CHAR(8) CHARACTER SET LATIN NOT CASESPECIFIC,
      PRDT_CD CHAR(6) CHARACTER SET LATIN NOT CASESPECIFIC,
      CCY_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      OPEN_DT DATE FORMAT 'YYYY-MM-DD',
      CLOSE_DT DATE FORMAT 'YYYY-MM-DD',
      ACCT_STATUS_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      PRIMARY_PARTY_ID CHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC,
      OD_LIMIT_AMT DECIMAL(18,2),
      LAST_CUST_ACTV_DT DATE FORMAT 'YYYY-MM-DD',
      OPEN_CHNL_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      ACTION_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKKYC_ACCT_STG ( ACCT_ID );
