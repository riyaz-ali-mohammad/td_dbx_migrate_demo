CREATE SET TABLE DB_TRANS_IMPORTS.SANC_NAME_STG ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      GROUP_ID INTEGER NOT NULL,
      NAME_SEQ_NR SMALLINT NOT NULL,
      FULL_NM VARCHAR(400) CHARACTER SET LATIN NOT CASESPECIFIC,
      NORM_NM VARCHAR(400) CHARACTER SET LATIN NOT CASESPECIFIC,
      NON_LATIN_NM VARCHAR(200) CHARACTER SET UNICODE NOT CASESPECIFIC,
      ALIAS_TYP_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      ALIAS_QUALITY_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKSANC_NAME_STG ( GROUP_ID ,NAME_SEQ_NR );
