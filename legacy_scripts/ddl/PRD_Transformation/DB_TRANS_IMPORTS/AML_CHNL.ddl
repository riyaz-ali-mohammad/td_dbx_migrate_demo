CREATE SET TABLE DB_TRANS_IMPORTS.AML_CHNL ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      CHNL_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      CHNL_DESC VARCHAR(40) CHARACTER SET LATIN NOT CASESPECIFIC,
      DIGITAL_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      ACTION_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKAML_CHNL ( CHNL_CD );
