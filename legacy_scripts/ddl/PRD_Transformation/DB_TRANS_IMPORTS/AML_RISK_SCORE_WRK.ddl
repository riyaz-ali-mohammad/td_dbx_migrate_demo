CREATE SET TABLE DB_TRANS_IMPORTS.AML_RISK_SCORE_WRK ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      PARTY_ID CHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      SCORE_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      CTRY_SCORE SMALLINT,
      PEP_SCORE SMALLINT,
      OCCP_SCORE SMALLINT,
      PRDT_SCORE SMALLINT,
      CHNL_SCORE SMALLINT,
      ALERT_SCORE SMALLINT,
      SANC_SCORE SMALLINT,
      KYC_SCORE SMALLINT,
      ADV_MEDIA_SCORE SMALLINT,
      TOTAL_SCORE SMALLINT,
      RISK_BAND_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKAML_RISK_SCORE_WRK ( PARTY_ID );
