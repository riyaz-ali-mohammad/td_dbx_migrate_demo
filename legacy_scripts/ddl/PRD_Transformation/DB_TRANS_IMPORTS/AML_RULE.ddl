CREATE SET TABLE DB_TRANS_IMPORTS.AML_RULE ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      RULE_CD CHAR(8) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      SEGMENT_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      AMT_THRESHOLD DECIMAL(18,2),
      CNT_THRESHOLD INTEGER,
      LOOKBACK_DAYS SMALLINT,
      PCT_THRESHOLD DECIMAL(7,2),
      SCORE_WEIGHT SMALLINT,
      ACTIVE_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      RULE_DESC VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC,
      ACTION_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKAML_RULE ( RULE_CD ,SEGMENT_CD );
