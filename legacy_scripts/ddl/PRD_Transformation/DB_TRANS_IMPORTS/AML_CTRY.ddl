CREATE SET TABLE DB_TRANS_IMPORTS.AML_CTRY ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      CTRY_2_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      CTRY_3_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      CTRY_NM VARCHAR(50) CHARACTER SET LATIN NOT CASESPECIFIC,
      FATF_STATUS_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      HMT_HIGH_RISK_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      EU_HIGH_RISK_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      BASEL_AML_SCORE DECIMAL(5,2),
      CPI_SCORE SMALLINT,
      OFFSHORE_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      REGION_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      VALID_FROM_DT DATE FORMAT 'YYYY-MM-DD',
      VALID_TO_DT DATE FORMAT 'YYYY-MM-DD',
      ACTION_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKAML_CTRY ( CTRY_2_CD );
