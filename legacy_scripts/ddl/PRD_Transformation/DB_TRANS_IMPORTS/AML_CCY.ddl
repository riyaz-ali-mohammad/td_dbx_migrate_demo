CREATE SET TABLE DB_TRANS_IMPORTS.AML_CCY ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      CCY_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      CCY_NM VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC,
      MINOR_UNIT_CNT BYTEINT,
      CCY_NUM_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      ACTIVE_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      ACTION_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKAML_CCY ( CCY_CD );
