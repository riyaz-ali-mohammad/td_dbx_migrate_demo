CREATE SET TABLE DB_TRANS_IMPORTS.AML_OCCP ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      SIC_CD CHAR(5) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      SIC_DESC VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC,
      SIC_RISK_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      CASH_INTENSIVE_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      ACTION_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKAML_OCCP ( SIC_CD );
