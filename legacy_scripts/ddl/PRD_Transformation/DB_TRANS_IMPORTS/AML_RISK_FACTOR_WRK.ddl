CREATE MULTISET TABLE DB_TRANS_IMPORTS.AML_RISK_FACTOR_WRK ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      PARTY_ID CHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      FACTOR_CD CHAR(8) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      FACTOR_VALUE_CD VARCHAR(20) CHARACTER SET LATIN NOT CASESPECIFIC,
      SCORE_PTS SMALLINT)
PRIMARY INDEX XNUPI_AML_RISK_FACTOR_WRK ( PARTY_ID );
