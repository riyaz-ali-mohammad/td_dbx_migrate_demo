CREATE SET TABLE DB_TRANS_IMPORTS.DLYTXN_NEW_CPTY ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      CPTY_ACCT_KEY VARCHAR(34) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      CPTY_NORM_NM VARCHAR(140) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      CPTY_BIC_CD CHAR(11) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_CTRY_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      FIRST_SEEN_DT DATE FORMAT 'YYYY-MM-DD')
UNIQUE PRIMARY INDEX XPKDLYTXN_NEW_CPTY ( CPTY_ACCT_KEY ,CPTY_NORM_NM );
