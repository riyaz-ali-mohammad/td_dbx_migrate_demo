CREATE SET TABLE DB_TRANS_IMPORTS.DLYTXN_LOAD_TMS ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      SSQ_ID BYTEINT NOT NULL,
      LOAD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL,
      BUSINESS_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      FILE_ID CHAR(20) CHARACTER SET LATIN NOT CASESPECIFIC,
      SUPPLIER_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKDLYTXN_LOAD_TMS ( SSQ_ID );
