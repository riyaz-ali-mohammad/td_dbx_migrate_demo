CREATE SET TABLE DB_TRANS_IMPORTS.DLYTXN_CPTY ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      TXN_REF VARCHAR(35) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      SUPPLIER_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      CPTY_ID BIGINT,
      CPTY_ACCT_KEY VARCHAR(34) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_NORM_NM VARCHAR(140) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_CTRY_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_BANK_CTRY_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_INTERNAL_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_ACCT_ID CHAR(14) CHARACTER SET LATIN NOT CASESPECIFIC,
      CPTY_PARTY_ID CHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC,
      NEW_CPTY_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKDLYTXN_CPTY ( TXN_REF ,SUPPLIER_CD );
