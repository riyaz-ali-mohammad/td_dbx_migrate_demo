CREATE SET TABLE DB_TRANS_IMPORTS.AML_CASE_WRK ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      PARTY_ID CHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      CASE_ID BIGINT,
      EXISTING_CASE_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      ALERT_CNT INTEGER,
      TOTAL_ALERT_SCORE INTEGER,
      TOTAL_HIT_GBP_AMT DECIMAL(18,2),
      MAX_RULE_SCORE SMALLINT,
      FIRST_ALERT_DT DATE FORMAT 'YYYY-MM-DD',
      LAST_ALERT_DT DATE FORMAT 'YYYY-MM-DD',
      RULE_LIST VARCHAR(200) CHARACTER SET LATIN NOT CASESPECIFIC,
      SEGMENT_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      RISK_BAND_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      CASE_PRIORITY_NR BYTEINT,
      QUEUE_CD CHAR(6) CHARACTER SET LATIN NOT CASESPECIFIC,
      SLA_DUE_DT DATE FORMAT 'YYYY-MM-DD')
UNIQUE PRIMARY INDEX XPKAML_CASE_WRK ( PARTY_ID );
