CREATE SET TABLE DB_TRANS_IMPORTS.AML_TMS_KYCSYS ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      SSQ_ID BYTEINT NOT NULL,
      TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
UNIQUE PRIMARY INDEX XPKAML_TMS_KYCSYS ( SSQ_ID );
