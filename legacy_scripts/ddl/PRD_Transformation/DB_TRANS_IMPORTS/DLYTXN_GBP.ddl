CREATE SET TABLE DB_TRANS_IMPORTS.DLYTXN_GBP ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      TXN_REF VARCHAR(35) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      SUPPLIER_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      TXN_CCY CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      TXN_AMT DECIMAL(18,2),
      RATE_DT DATE FORMAT 'YYYY-MM-DD',
      GBP_RATE DECIMAL(18,8),
      GBP_AMT DECIMAL(18,2),
      RATE_FALLBACK_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKDLYTXN_GBP ( TXN_REF ,SUPPLIER_CD );
