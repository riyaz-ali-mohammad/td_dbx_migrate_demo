CREATE SET TABLE DB_ODS.PRDT ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      PRDT_CD CHAR(6) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      START_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      END_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL DEFAULT DATE '9999-12-31',
      PRDT_DESC VARCHAR(50) CHARACTER SET LATIN NOT CASESPECIFIC,
      PRDT_FAMILY_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC,
      SEGMENT_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      PRDT_RISK_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
UNIQUE PRIMARY INDEX XPKPRDT ( PRDT_CD ,START_DT );
