CREATE SET TABLE DB_ODS.PARTY_SNAPSHOT ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      PARTY_ID CHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      PARTY_TYP_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      SEGMENT_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      RISK_RATING_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      PEP_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      RESIDENCE_CTRY_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      SIC_CD CHAR(5) CHARACTER SET LATIN NOT CASESPECIFIC,
      KYC_STATUS_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      EXP_MTH_TURNOVER_AMT DECIMAL(18,2),
      ONBOARD_DT DATE FORMAT 'YYYY-MM-DD')
UNIQUE PRIMARY INDEX XPKPARTY_SNAPSHOT ( PARTY_ID );
