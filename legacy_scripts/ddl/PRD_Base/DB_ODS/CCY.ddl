CREATE SET TABLE DB_ODS.CCY ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      CCY_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      START_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      END_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL DEFAULT DATE '9999-12-31',
      CCY_NM VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC,
      MINOR_UNIT_CNT BYTEINT,
      CCY_NUM_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      ACTIVE_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
UNIQUE PRIMARY INDEX XPKCCY ( CCY_CD ,START_DT );
