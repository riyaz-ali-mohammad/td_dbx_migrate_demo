CREATE SET TABLE DB_ODS.PARTY_ACCT_REL ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      PARTY_ID CHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      ACCT_ID CHAR(14) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      ROLE_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      START_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      END_DT DATE FORMAT 'YYYY-MM-DD' DEFAULT DATE '9999-12-31',
      OWNERSHIP_PCT DECIMAL(5,2),
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
UNIQUE PRIMARY INDEX XPKPARTY_ACCT_REL ( PARTY_ID ,ACCT_ID ,ROLE_CD ,START_DT )
INDEX XNUSI_PTAC_ACCT ( ACCT_ID );
