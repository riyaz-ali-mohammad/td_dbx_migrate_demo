CREATE SET TABLE DB_REFERENCE.CASE_QUEUE ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      QUEUE_CD CHAR(6) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      QUEUE_NM VARCHAR(50) CHARACTER SET LATIN NOT CASESPECIFIC,
      SEGMENT_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      MIN_PRIORITY_NR BYTEINT NOT NULL,
      MAX_PRIORITY_NR BYTEINT NOT NULL,
      SLA_BUS_DAYS SMALLINT)
UNIQUE PRIMARY INDEX XPKCASE_QUEUE ( QUEUE_CD );
