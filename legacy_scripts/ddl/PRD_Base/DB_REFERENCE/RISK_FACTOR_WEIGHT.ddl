CREATE SET TABLE DB_REFERENCE.RISK_FACTOR_WEIGHT ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      FACTOR_CD CHAR(8) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      FACTOR_VALUE_CD VARCHAR(20) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      SCORE_PTS SMALLINT NOT NULL,
      FACTOR_DESC VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKRISK_FACTOR_WEIGHT ( FACTOR_CD ,FACTOR_VALUE_CD );
