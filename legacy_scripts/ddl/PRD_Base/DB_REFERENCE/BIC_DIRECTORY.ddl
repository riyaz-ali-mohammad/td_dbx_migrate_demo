CREATE SET TABLE DB_REFERENCE.BIC_DIRECTORY ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      BIC_CD CHAR(11) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      BANK_NM VARCHAR(60) CHARACTER SET LATIN NOT CASESPECIFIC,
      CTRY_2_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      AUTO_ADDED_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC DEFAULT 'N',
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS')
UNIQUE PRIMARY INDEX XPKBIC_DIRECTORY ( BIC_CD );
