CREATE SET TABLE DB_REFERENCE.VIEW_ACCESS_CTRL ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      USER_NM VARCHAR(128) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      SEGMENT_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      PII_ACCESS_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC DEFAULT 'N',
      SAR_ACCESS_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC DEFAULT 'N')
UNIQUE PRIMARY INDEX XPKVIEW_ACCESS_CTRL ( USER_NM ,SEGMENT_CD );
