CREATE SET TABLE DB_REFERENCE.CALENDAR ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      CAL_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      BUS_DAY_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      YR_MON INTEGER,
      YR_NR SMALLINT,
      MTH_NR BYTEINT,
      DAY_OF_WK_NR BYTEINT,
      MTH_END_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKCALENDAR ( CAL_DT );
