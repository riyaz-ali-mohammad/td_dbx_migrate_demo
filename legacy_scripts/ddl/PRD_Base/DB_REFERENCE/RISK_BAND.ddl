CREATE SET TABLE DB_REFERENCE.RISK_BAND ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      RISK_BAND_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      MIN_SCORE SMALLINT NOT NULL,
      MAX_SCORE SMALLINT NOT NULL,
      RISK_BAND_DESC VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC,
      REVIEW_FREQ_MTHS SMALLINT,
      CDD_LEVEL_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKRISK_BAND ( RISK_BAND_CD );
