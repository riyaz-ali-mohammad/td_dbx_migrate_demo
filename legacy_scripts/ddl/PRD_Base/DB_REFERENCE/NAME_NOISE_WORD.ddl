CREATE SET TABLE DB_REFERENCE.NAME_NOISE_WORD ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      NOISE_WORD VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      WORD_TYP_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC)
UNIQUE PRIMARY INDEX XPKNAME_NOISE_WORD ( NOISE_WORD );
