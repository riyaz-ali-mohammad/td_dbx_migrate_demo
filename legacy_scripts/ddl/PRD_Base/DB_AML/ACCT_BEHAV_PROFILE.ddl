CREATE SET TABLE DB_AML.ACCT_BEHAV_PROFILE ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      ACCT_ID CHAR(14) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      BUSINESS_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      PARTY_ID CHAR(12) CHARACTER SET LATIN NOT CASESPECIFIC,
      SEGMENT_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      ROLL_7D_CR_GBP_AMT DECIMAL(18,2),
      ROLL_7D_CASH_CR_GBP_AMT DECIMAL(18,2),
      ROLL_7D_NEAR_THRESH_CNT INTEGER,
      ROLL_30D_CR_GBP_AMT DECIMAL(18,2),
      ROLL_30D_DR_GBP_AMT DECIMAL(18,2),
      ROLL_30D_CASH_CR_GBP_AMT DECIMAL(18,2),
      ROLL_30D_ROUND_AMT_CNT INTEGER,
      ROLL_30D_HRC_GBP_AMT DECIMAL(18,2),
      ROLL_3D_CPTY_CR_CNT INTEGER,
      PRIOR_90D_AVG_MTH_CR_AMT DECIMAL(18,2),
      VELOCITY_RATIO DECIMAL(9,2),
      DAYS_SINCE_PREV_ACTV INTEGER,
      CUM_CR_GBP_AMT DECIMAL(18,2),
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
UNIQUE PRIMARY INDEX XPKACCT_BEHAV_PROFILE ( ACCT_ID ,BUSINESS_DT );
