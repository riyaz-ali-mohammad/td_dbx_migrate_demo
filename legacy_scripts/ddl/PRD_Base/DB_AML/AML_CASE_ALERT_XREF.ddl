CREATE SET TABLE DB_AML.AML_CASE_ALERT_XREF ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      CASE_ID BIGINT NOT NULL,
      ALERT_ID BIGINT NOT NULL,
      ADDED_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS')
UNIQUE PRIMARY INDEX XPKAML_CASE_ALERT_XREF ( CASE_ID ,ALERT_ID );
