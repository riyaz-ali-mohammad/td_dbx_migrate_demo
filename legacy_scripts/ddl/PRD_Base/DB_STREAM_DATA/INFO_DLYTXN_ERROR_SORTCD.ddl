CREATE SET TABLE DB_STREAM_DATA.INFO_DLYTXN_ERROR_SORTCD ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      SORT_CD CHAR(6) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      ERR_FIELD VARCHAR(30) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
UNIQUE PRIMARY INDEX XPKINFO_DLYTXN_ERROR_SORTCD ( SORT_CD ,ERR_FIELD );
