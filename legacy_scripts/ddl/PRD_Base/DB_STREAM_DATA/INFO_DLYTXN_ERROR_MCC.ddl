CREATE SET TABLE DB_STREAM_DATA.INFO_DLYTXN_ERROR_MCC ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      MCC_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
UNIQUE PRIMARY INDEX XPKINFO_DLYTXN_ERROR_MCC ( MCC_CD );
