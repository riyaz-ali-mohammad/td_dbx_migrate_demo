CREATE SET TABLE DB_STREAM_DATA.INFO_DLYTXN_ERROR_ACCT ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      ACCT_ID CHAR(14) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      SORT_CD CHAR(6) CHARACTER SET LATIN NOT CASESPECIFIC,
      ACCT_NR CHAR(8) CHARACTER SET LATIN NOT CASESPECIFIC,
      TXN_CNT INTEGER,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
UNIQUE PRIMARY INDEX XPKINFO_DLYTXN_ERROR_ACCT ( ACCT_ID );
