CREATE SET TABLE DB_STREAM_DATA.INFO_DLYTXN_CTRL_RECON ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      FILE_ID CHAR(20) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      SUPPLIER_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      EXTRACT_DT DATE FORMAT 'YYYY-MM-DD',
      EXP_REC_CNT INTEGER,
      ACT_REC_CNT INTEGER,
      EXP_DR_TOTAL DECIMAL(18,2),
      ACT_DR_TOTAL DECIMAL(18,2),
      EXP_CR_TOTAL DECIMAL(18,2),
      ACT_CR_TOTAL DECIMAL(18,2),
      RECON_STATUS_CD CHAR(4) CHARACTER SET LATIN NOT CASESPECIFIC,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS' NOT NULL)
UNIQUE PRIMARY INDEX XPKINFO_DLYTXN_CTRL_RECON ( FILE_ID ,SUPPLIER_CD );
