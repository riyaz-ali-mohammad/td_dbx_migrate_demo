CREATE SET TABLE DB_AML_MI.ALERT_SUMM_DAILY ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      BUSINESS_DT DATE FORMAT 'YYYY-MM-DD' NOT NULL,
      RULE_CD CHAR(8) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      SEGMENT_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      RISK_BAND_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      ALERT_CNT INTEGER,
      PARTY_CNT INTEGER,
      ACCT_CNT INTEGER,
      TOTAL_HIT_GBP_AMT DECIMAL(18,2),
      AVG_ALERT_SCORE DECIMAL(9,2),
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS')
UNIQUE PRIMARY INDEX XPKALERT_SUMM_DAILY ( BUSINESS_DT ,RULE_CD ,SEGMENT_CD ,RISK_BAND_CD );
