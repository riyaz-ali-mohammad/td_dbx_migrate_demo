CREATE SET TABLE DB_AML_MI.DIM_COUNTRY ,FALLBACK ,
     NO BEFORE JOURNAL,
     NO AFTER JOURNAL,
     CHECKSUM = DEFAULT,
     DEFAULT MERGEBLOCKRATIO,
     MAP = TD_MAP1
     (
      CTRY_2_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC NOT NULL,
      CTRY_3_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      CTRY_NM VARCHAR(50) CHARACTER SET LATIN NOT CASESPECIFIC,
      REGION_CD CHAR(3) CHARACTER SET LATIN NOT CASESPECIFIC,
      FATF_STATUS_CD CHAR(2) CHARACTER SET LATIN NOT CASESPECIFIC,
      CTRY_RISK_CD CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      HRC_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      SANCTIONED_IND CHAR(1) CHARACTER SET LATIN NOT CASESPECIFIC,
      CO_UPD_TMS TIMESTAMP(0) FORMAT 'YYYY-MM-DDBHH:MI:SS')
UNIQUE PRIMARY INDEX XPKDIM_COUNTRY ( CTRY_2_CD );
